{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "jsx": "preserve",
        "allowJs": true,
        "incremental": true,
        "allowImportingTsExtensions": true,
        "plugins": [{ "name": "next" }],
        "paths": { "@/*": ["./src/*"] }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts", "*.ts"],
    "exclude": ["node_modules"]
}
