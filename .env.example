#  Environment contract for altered-generated-opus.
#
#  Every variable here is required at startup unless marked optional. Missing configuration is a
#  hard boot failure, never a silent default - see the fail-closed rule in AGENTS.md.
#
#  The Vercel project is the source of truth. Agents pull values from it with the CLI command in
#  knowledge/constraints.md; the deployed application reads them directly.


#  === Runtime ===

#  development | preview | production
#
#  Vercel holds a separate "development" value, so a pulled development file is already correct.
#  Pull it with the CLI command recorded in knowledge/constraints.md, into apps/web/.env.local.
APP_ENV=
#  Public origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=

#  Master kill switch for every live outbound write: messages, posts, payments.
#  Defaults to off. Nothing reaches a real recipient while this is false.
OUTBOUND_ENABLED=false


#  === Database: Neon Postgres ===

#  Pooled connection string.
DATABASE_URL=


#  === Cache and chat state: Upstash Redis ===

#  Protocol URL (rediss://), used by the chat state adapter.
REDIS_URL=
#  REST credentials, used by serverless paths where a pooled connection is wrong.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


#  === Scheduling and queues: Upstash QStash ===

QSTASH_URL=
QSTASH_TOKEN=
#  Both signing keys are required. Webhook verification refuses every request when they are absent.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=


#  === AI: OpenRouter, via AI SDK v7 ===

OPENROUTER_API_KEY=


#  === iMessage: Sendblue ===

SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
#  The dedicated line for this project, E.164 format.
SENDBLUE_PHONE_NUMBER=
#  Webhook signature secret.
SENDBLUE_SIGNING_SECRET=


#  === Operator identity ===

#  The owner's number, E.164. Used to route the operator experience.
#  Identity is verified properly in the app; this is the seed, not the auth.
OPERATOR_PHONE_NUMBER=


#  === Dashboard auth: Better Auth with email codes, delivered by Resend ===

#  Random 32-byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
RESEND_API_KEY=
#  Sender for login codes, on a domain verified in Resend.
AUTH_EMAIL_FROM=


#  === Payments: Autumn ===

AUTUMN_SECRET_KEY=


#  === Social publishing: Zernio ===

ZERNIO_API_KEY=
ZERNIO_X_ACCOUNT_ID=


#  === Agent integration ===

#  Lets the iMessage operator agent report on running and finished coding tasks.
CURSOR_API_KEY=
#  Broader read scope than the per-run token, so agents can reach the notes and reference repos.
GITHUB_TOKEN=


#  === Operations, read-only by policy ===

VERCEL_TOKEN=


#  === Still undecided ===
#
#  Analytics has no chosen provider yet. Its variables will be appended here once it is decided.
